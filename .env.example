# Firebase — client-side (safe to expose; scoped to this Firebase project only)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK — SERVER-SIDE ONLY (never prefix with NEXT_PUBLIC_)
FIREBASE_ADMIN_SERVICE_ACCOUNT=   # Full JSON string of the service account key

# Appwrite — client-side
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_WISHES_BUCKET_ID=
NEXT_PUBLIC_APPWRITE_GALLERY_BUCKET_ID=

# Appwrite — SERVER-SIDE ONLY
APPWRITE_API_KEY=

# App configuration
REVEAL_TIMESTAMP=                 # ISO 8601, e.g. 2026-09-15T18:00:00+05:30
NEXT_PUBLIC_APP_URL=              # e.g. https://example.me
